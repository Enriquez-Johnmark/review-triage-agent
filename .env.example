# Copy to .env (ignored by git). Your Anthropic API key, for `sort` and
# `eval --record`; never a Claude subscription.
ANTHROPIC_API_KEY=

# The support channel every reply ends with, e.g. "Message us in the app: Help > Chat."
SUPPORT_CHANNEL=

# Only with the app owner's Play Console access: the path of their Google
# service account key. Without it, replies go to the stand-in (nothing is posted).
GOOGLE_PLAY_CREDENTIALS=

# Only for the n8n daily summary: a long random token (24+ characters) that
# n8n sends. With it, `pnpm cli serve` also opens the summary on port 4318
# (SUMMARY_PORT), reachable from Docker; without it, nothing but the
# dashboard on 127.0.0.1 is opened.
SUMMARY_TOKEN=
