{
  "name": "review-triage-agent",
  "version": "0.1.0",
  "private": true,
  "description": "An AI agent that turns an app's public reviews into sorted issues, spikes and replies a person approves.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cli": "tsx src/cli.ts",
    "check:data": "tsx scripts/check-no-review-data.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@fastify/static": "^8.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "12",
    "fastify": "^5.12.8",
    "google-auth-library": "^10.9.1",
    "google-play-scraper": "^10.1.4",
    "zod": "^4.6.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
